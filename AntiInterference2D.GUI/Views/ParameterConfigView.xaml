<UserControl x:Class="AntiInterference2D.GUI.Views.ParameterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：推理参数 -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="8">
            <StackPanel>
                <TextBlock Text="推理参数配置" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="输入图像尺寸" FontWeight="SemiBold" Margin="0,4"/>
                <ComboBox SelectedItem="{Binding ImgSize}" Margin="0,2">
                    <ComboBoxItem Content="256" IsSelected="False"/>
                    <ComboBoxItem Content="512" IsSelected="True"/>
                    <ComboBoxItem Content="1024"/>
                    <ComboBoxItem Content="2048"/>
                </ComboBox>

                <CheckBox Content="启用 HDR 预处理" IsChecked="{Binding UseHdr}" Margin="0,8"/>
                <CheckBox Content="修复高光区域" IsChecked="{Binding UseHighlightRepair}" Margin="0,4"/>
                <CheckBox Content="返回可视化图像" IsChecked="{Binding ReturnVisualization}" Margin="0,4"/>
                <CheckBox Content="返回定位坐标" IsChecked="{Binding ReturnCoordinates}" Margin="0,4"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="分割阈值" FontWeight="SemiBold" Margin="0,4"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding SegThreshold}" 
                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding SegThreshold, StringFormat='当前值: {0:F2}'}" 
                           Style="{StaticResource SubtitleTextStyle}"/>

                <TextBlock Text="边缘阈值" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding EdgeThreshold}" 
                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding EdgeThreshold, StringFormat='当前值: {0:F2}'}" 
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>
        </Border>

        <!-- 右侧：设备与后端 -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8">
            <StackPanel>
                <TextBlock Text="设备与后端" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="推理设备" FontWeight="SemiBold" Margin="0,4"/>
                <ComboBox Text="{Binding Device}" Margin="0,2">
                    <ComboBoxItem Content="auto"/>
                    <ComboBoxItem Content="cpu"/>
                    <ComboBoxItem Content="cuda"/>
                </ComboBox>

                <TextBlock Text="推理后端" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ComboBox Text="{Binding Backend}" Margin="0,2">
                    <ComboBoxItem Content="pytorch"/>
                    <ComboBoxItem Content="onnx"/>
                    <ComboBoxItem Content="tensorrt"/>
                </ComboBox>

                <Separator Margin="0,24"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 保存配置" 
                            Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="4"/>
                    <Button Content="🔄 重置默认" 
                            Command="{Binding ResetDefaultsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="4"
                            Background="{StaticResource WarningBrush}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" 
                           Margin="0,12"
                           Foreground="{StaticResource SuccessBrush}"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
