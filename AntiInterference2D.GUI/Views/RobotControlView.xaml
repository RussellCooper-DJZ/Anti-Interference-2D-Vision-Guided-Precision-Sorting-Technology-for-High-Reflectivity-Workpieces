<UserControl x:Class="AntiInterference2D.GUI.Views.RobotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：连接与状态 -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="8">
            <StackPanel>
                <TextBlock Text="机器人控制" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="连接配置" FontWeight="SemiBold" Margin="0,4"/>
                <TextBlock Text="主机地址" Style="{StaticResource SubtitleTextStyle}" Margin="0,2"/>
                <TextBox Text="{Binding RobotHost}" Margin="0,2"/>
                <TextBlock Text="端口" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,2"/>
                <TextBox Text="{Binding RobotPort}" Margin="0,2"/>

                <StackPanel Orientation="Horizontal" Margin="0,12">
                    <Button Content="🔗 连接" 
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="4"/>
                    <Button Content="❌ 断开" 
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="4"
                            Background="{StaticResource DangerBrush}"/>
                </StackPanel>

                <TextBlock Text="{Binding ConnectionStatus}" 
                           FontWeight="SemiBold" Margin="0,4"/>

                <Separator Margin="0,16"/>

                <Button Content="📡 查询状态" 
                        Command="{Binding QueryStatusCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,4"/>

                <TextBlock Text="响应:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBox Text="{Binding RobotResponse}" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap"
                         Height="120"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>

        <!-- 右侧：目标位姿 -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8">
            <StackPanel>
                <TextBlock Text="目标位姿 (mm / deg)" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetX}" Margin="4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetY}" Margin="4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetZ}" Margin="4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="RX:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TargetRx}" Margin="4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="RY:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TargetRy}" Margin="4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="RZ:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TargetRz}" Margin="4"/>
                </Grid>

                <Button Content="📤 发送目标位姿" 
                        Command="{Binding SendTargetCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
