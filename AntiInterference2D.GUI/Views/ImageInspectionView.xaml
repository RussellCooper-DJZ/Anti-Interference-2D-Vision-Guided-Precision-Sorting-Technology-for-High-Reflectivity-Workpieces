<UserControl x:Class="AntiInterference2D.GUI.Views.ImageInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AntiInterference2D.GUI.Converters">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧控制面板 -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="图像检测" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                    <Button Content="📂 选择图像" 
                            Command="{Binding SelectImageCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,4"/>

                    <TextBlock Text="{Binding SelectedImagePath}" 
                               Style="{StaticResource SubtitleTextStyle}"
                               TextTrimming="CharacterEllipsis" Margin="0,8"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="预处理选项" FontWeight="SemiBold" Margin="0,4"/>
                    <CheckBox Content="启用 HDR" IsChecked="{Binding UseHdr}" Margin="4,4"/>
                    <CheckBox Content="修复高光区域" IsChecked="{Binding UseHighlightRepair}" Margin="4,4"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="阈值参数" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock Text="{Binding SegThreshold, StringFormat='分割阈值: {0:F2}'}" Margin="4,2"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding SegThreshold}" 
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="4,2"/>

                    <TextBlock Text="{Binding EdgeThreshold, StringFormat='边缘阈值: {0:F2}'}" Margin="4,2"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding EdgeThreshold}" 
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="4,2"/>

                    <Separator Margin="0,12"/>

                    <Button Content="▶ 开始检测" 
                            Command="{Binding StartInspectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,4"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>

                    <Button Content="💾 保存结果" 
                            Command="{Binding SaveResultCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,4"
                            Background="{StaticResource SuccessBrush}"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="{Binding ResultText}" 
                               TextWrapping="Wrap" Margin="0,4"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding LatencyText, StringFormat='延迟: {0}'}" 
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,2"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧图像显示区 -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 原图 -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock Text="原始图像" 
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Background="#80000000" Foreground="White" Padding="4,2"/>
                    <Image Source="{Binding OriginalImage}" 
                           Stretch="Uniform" Margin="0,24,0,0"/>
                </Grid>
            </Border>

            <!-- 结果图（四宫格） -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock Text="检测结果" 
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Background="#80000000" Foreground="White" Padding="4,2"/>
                    <Image Source="{Binding ResultImage}" 
                           Stretch="Uniform" Margin="0,24,0,0"/>
                    <TextBlock Text="等待检测..." 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ResultImage, Converter={StaticResource NullToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- 分割掩膜 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock Text="分割掩膜" 
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Background="#80000000" Foreground="White" Padding="4,2"/>
                    <Image Source="{Binding SegMaskImage}" 
                           Stretch="Uniform" Margin="0,24,0,0"/>
                </Grid>
            </Border>

            <!-- 边缘掩膜 -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock Text="边缘掩膜" 
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Background="#80000000" Foreground="White" Padding="4,2"/>
                    <Image Source="{Binding EdgeMaskImage}" 
                           Stretch="Uniform" Margin="0,24,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
