<UserControl x:Class="AntiInterference2D.GUI.Views.BatchProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="批量处理" 
                   Style="{StaticResource TitleTextStyle}" Margin="8"/>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8">
            <Button Content="📂 选择文件夹" 
                    Command="{Binding SelectFolderCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="4"/>
            <Button Content="▶ 开始批量检测" 
                    Command="{Binding StartBatchCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="4"/>
            <Button Content="💾 导出 CSV" 
                    Command="{Binding ExportResultsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="4"
                    Background="{StaticResource SuccessBrush}"/>
            <TextBlock Text="{Binding ProgressText}" 
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- 文件列表 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="8">
            <DataGrid ItemsSource="{Binding Items}" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="200"/>
                    <DataGridCheckBoxColumn Header="成功" Binding="{Binding Success}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部参数 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="8">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="启用 HDR" IsChecked="{Binding UseHdr}" Margin="8,4"/>
                <TextBlock Text="分割阈值:" VerticalAlignment="Center" Margin="16,4,4,4"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding SegThreshold}" 
                        Width="120" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Text="边缘阈值:" VerticalAlignment="Center" Margin="16,4,4,4"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding EdgeThreshold}" 
                        Width="120" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
