# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Matches multiple files with brace expansion notation
# Set default charset
[*.{py,c,h,md,txt,yml,yaml,json,toml}]
charset = utf-8

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 127

# C files
[*.{c,h}]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# YAML/JSON/TOML files
[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2
