# ============================================================
# 根目录级 Git 忽略规则
# 说明：核心代码仓库在 Anti-Interference-2D-Vision/ 内，
#       根目录仅存放工作区资产，以下目录不纳入版本控制。
# ============================================================

# 运行结果与中间产物
results/

# 数据资产（测试图、视频，体积大）
assets/

# 团队与比赛资料（非代码）
competition/
team/

# 归档历史版本
archive/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.env
.venv/
env/
venv/

# 日志与临时文件
*.log
*.tmp
*.bak

# 压缩包
*.zip
*.rar
*.7z
